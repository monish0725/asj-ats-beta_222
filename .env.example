COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-a-03-2025

# Real OTP authentication / users database.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
DB_SSL=true
DB_POOL_MAX=10
APP_DB_PROVIDER=supabase
APP_STATE_TABLE=app_state
APP_STATE_KEY=production
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Local/dev default: OTP emails are printed in the terminal instead of sent.
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=ASJ Recruitment ATS
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
CORS_ORIGIN=http://127.0.0.1:4200
COOKIE_SAMESITE=none

# Private resume/document storage. Keep the bucket private; the backend proxies files
# after authentication instead of exposing public Supabase object URLs.
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=resumes

# Real candidate email sending. Use an app password/API SMTP credential.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
